#include <stdio.h>

int bestFit(int items[], int n, int capacity) {
    int bins[n];  // stores remaining capacity of each bin

    // Initialize all bins as empty
    for (int i = 0; i < n; i++) {
        bins[i] = capacity;
    }

    int binCount = 0;

    // Traverse through each item
    for (int i = 0; i < n; i++) {
        int bestIndex = -1;
        int minSpaceLeft = capacity + 1;

        // Find the best bin for current item
        for (int j = 0; j < binCount; j++) {
            if (bins[j] >= items[i] && (bins[j] - items[i]) < minSpaceLeft) {
                bestIndex = j;
                minSpaceLeft = bins[j] - items[i];
            }
        }

        // If no bin found, create a new bin
        if (bestIndex == -1) {
            bins[binCount] = capacity - items[i];
            binCount++;
        } else {
            // Place item in best bin
            bins[bestIndex] -= items[i];
        }
    }

    return binCount;
}

int main() {
    int items[] = {4, 8, 1, 4, 2, 1};
    int n = sizeof(items) / sizeof(items[0]);
    int capacity = 10;

    int result = bestFit(items, n, capacity);

    printf("Number of bins required: %d\n", result);

    return 0;
}
